# AirAware AI Environment Configuration
# Copy this file to .env.local for local development. Never commit .env files with secrets!

# Optional: Google Gemini API key for Cloud AI fallback.
# Kept strictly server-side in Netlify Functions, never exposed in client bundles.
# When omitted, the app operates flawlessly using WebLLM browser inference or deterministic intelligence.
GEMINI_API_KEY=

# Optional: OpenAQ API v3 Key.
# If omitted, AirAware AI automatically falls back to verified Open-Meteo Air Quality telemetry.
OPENAQ_API_KEY=
