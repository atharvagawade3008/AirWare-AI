# AirAware AI — Environment Variables
# Copy this file to .env for local development.
# Never commit real secrets — .env is gitignored.
#
# ── Vercel deployment ────────────────────────────────────────────────────────
# Set the variables below in the Vercel project dashboard:
#   Project → Settings → Environment Variables
# Variables prefixed VITE_ are embedded in the browser bundle.
# Variables WITHOUT the prefix are server-side only (API routes / functions).
# ─────────────────────────────────────────────────────────────────────────────

# --- Google Gemini Cloud AI (server-side only) ------------------------------
# Required for the conversational assistant. Read only by api/airaware-chat.ts
# and netlify/functions/airaware-chat.ts. Never use a VITE_ prefix.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Used when the primary model returns 503 UNAVAILABLE or 429 (the daily free-tier
# quota for that model is spent). Free-tier quota is per model, per day, so this is
# a real second bucket. Keep it on the free tier.
# Comma-separated list: quota and rate limits are per model, so extra free Flash
# models are extra capacity. Keep every entry on the free tier.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Output cap per answer. Flash models spend "thinking" tokens from this same cap,
# so 512 truncated replies; 1024 leaves room for a complete answer.
GEMINI_MAX_OUTPUT_TOKENS=1024
# Optional timings (milliseconds). Gemini rejects an explicit request deadline under
# 10000 with 400 INVALID_ARGUMENT, so GEMINI_TIMEOUT_MS is clamped up to 10000.
GEMINI_TIMEOUT_MS=12000
GEMINI_PRIMARY_ATTEMPT_MS=6000
GEMINI_TOTAL_BUDGET_MS=20000

# --- OpenAQ v3 API key (optional, server-side only) --------------------------
# If omitted, AirAware AI falls back to verified CAMS atmospheric model
# estimates via Open-Meteo (no key required).
# Get a free key at: https://explore.openaq.org/register
# Set as a plain (non-VITE) env var — it is only read by the proxy route.
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY
